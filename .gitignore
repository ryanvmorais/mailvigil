# --- 1. PYTHON: BYTECODE, BUILD, PACKAGING ---
# Compiled bytecode and packaging output — all regenerated by the build, never source.
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- 2. VIRTUAL ENVIRONMENTS (uv) ---
# `uv sync` recreates these. uv.lock IS committed, for reproducible builds.
.venv/
venv/
.uv/

# --- 3. TOOLING CACHES ---
# ruff, mypy, pytest, coverage — local speed-ups, never useful in Git.
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# --- 4. REAL DMARC REPORTS ---
# Real reports carry source IPs and domains: never commit them. Test and README samples are
# synthetic and live under tests/ (the negation below keeps them tracked).
*.xml.gz
*.xml.zip
reports/
# Exception: synthetic sample reports under tests/ are committed on purpose.
!tests/**/*.xml.gz
!tests/**/*.xml.zip

# --- 5. SECRETS AND LOCAL CONFIG ---
# Machine-specific overrides. There is no committed .env; the tool reads a TOML config.
.env
mailvigil.local.toml

# --- 6. EDITOR AND OS ---
.idea/
.vscode/
# Personal Claude Code overrides; the shared .claude/settings.json and hooks ARE committed.
.claude/settings.local.json
.DS_Store
Thumbs.db

# --- 7. LOCAL PLANNING / SCRATCH NOTES ---
# Superseded by specs/ once a feature is designed; never part of history.
/*.plan.md
.plans/
